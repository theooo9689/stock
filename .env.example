# Copie para .env. Nunca versionar o arquivo preenchido.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Codex oficial usando login ChatGPT; nunca usa a chave OpenAI neste caminho.
RESEARCH_PROVIDER=codex
CODEX_EXECUTABLE=codex
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=high
CODEX_TIMEOUT=900
CODEX_MAX_DAILY_CALLS=20
CODEX_MAX_INPUT_BYTES=150000
# Campos Ollama mantidos somente para compatibilidade com histórico/opção explícita.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT=32768
OLLAMA_TIMEOUT=600
# Chave opcional, apenas para ferramentas legadas explicitamente invocadas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=medium
DAILY_BUDGET_USD=3.00
# Preços por milhão de tokens. Conferir docs/pricing da OpenAI ao trocar o modelo.
MODEL_INPUT_USD_PER_MILLION=0.40
MODEL_OUTPUT_USD_PER_MILLION=1.60
WEB_SEARCH_USD_PER_CALL=0.01
RESEARCH_MAX_OUTPUT_TOKENS=12000
RESEARCH_MAX_TOOL_CALLS=6
RESEARCH_BACKGROUND=false
# Opcional: Financial Modeling Prep, plano que permita os endpoints usados.
FMP_API_KEY=
RADAR_DATA_DIR=data
RADAR_REPORTS_DIR=reports
RADAR_CONFIG=config/watchlist.yaml
RADAR_TIMEZONE=America/Sao_Paulo
RADAR_DELIVERY_TIME=20:30
